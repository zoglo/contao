{
    "devDependencies": {
        "@biomejs/biome": "^2.3",
        "@floating-ui/dom": "^1.7.5",
        "@hotwired/stimulus": "^3.2",
        "@hotwired/turbo": "^8.0.21",
        "@simplewebauthn/browser": "^13.1",
        "@stimulus-components/color-picker": "^2.0",
        "@stimulus-components/password-visibility": "^3.0",
        "@stylistic/stylelint-config": "^5.0",
        "@stylistic/stylelint-plugin": "^5.0",
        "@symfony/reprise": "^1.1",
        "@web-auth/webauthn-stimulus": "^5.3",
        "ace-builds": "^1.43.3",
        "focus-trap": "^8.0",
        "npm-run-all": "^4.1",
        "patch-package": "^8.0.1",
        "postcss": "^8.5",
        "postcss-preset-env": "^11.1",
        "sortablejs": "^1.15",
        "stimulus-textarea-autogrow": "^4.1",
        "stylelint": "^17.0",
        "stylelint-config-standard": "^40.0",
        "svgo": "^4.0",
        "vite": "^8.2"
    },
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "postinstall": "patch-package",
        "dev-server": "vite",
        "dev": "vite build --mode development",
        "watch": "vite build --mode development --watch",
        "build": "vite build",
        "lint:js": "biome check --write --unsafe core-bundle/assets",
        "lint:css": "stylelint --fix lax core-bundle/assets/styles",
        "lint:svg": "svgo -rf core-bundle/assets/icons",
        "lint": "run-s lint:js lint:css lint:svg"
    },
    "private": true,
    "packageManager": "npm@11.6.0"
}
